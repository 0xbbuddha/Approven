[Unit]
Description=nothing-approve daemon (phone fingerprint approval for sudo)
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/approved
Restart=on-failure
RestartSec=2
# Kept deliberately simple after 2 rounds of sandboxing directives that
# each broke something subtle: ProtectSystem=strict + ReadWritePaths
# failed to start at all (the target directory does not exist yet, and
# a plain ReadWritePaths cannot create one under ProtectHome), and even
# once that was fixed with StateDirectory=/RuntimeDirectory=, the same
# namespacing made a root caller's SO_PEERCRED show up as uid 65534
# (nobody) to this process, since root in the host's user namespace is
# not root in a namespaced one. NoNewPrivileges alone costs nothing and
# needs no directory of its own.
NoNewPrivileges=yes

[Install]
WantedBy=default.target
